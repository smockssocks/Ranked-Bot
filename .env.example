# ---------- Discord ----------
DISCORD_TOKEN=your_discord_bot_token_here
# Your server's ID. Discord > Settings > Advanced > Developer Mode ON,
# then right-click your server name > Copy Server ID.
DISCORD_GUILD_ID=your_guild_id_here
# Optional: where smurf flags go (or set later with /admin modchannel)
MOD_CHANNEL_ID=
# Optional: extra channel for auto-detected results (or /admin resultschannel)
RESULTS_CHANNEL_ID=

# ---------- Riot ----------
RIOT_API_KEY=your_riot_api_key_here
# RIOT_REGION is your server: na1 euw1 eun1 kr br1 la1 la2 oc1 tr1 ru jp1 ph2 sg2 th2 tw2 vn2 me1
# RIOT_PLATFORM must match it:
#   americas = na1 br1 la1 la2      europe = euw1 eun1 tr1 ru me1
#   asia     = kr jp1               sea    = oc1 ph2 sg2 th2 tw2 vn2
RIOT_REGION=na1
RIOT_PLATFORM=americas
# Tournament API (needs separate Riot approval). Leave blank: auto-detect works without it.
RIOT_TOURNAMENT_API_KEY=

# ---------- Database ----------
# Postgres for production; sqlite works out of the box for trying things out.
DATABASE_URL=sqlite+aiosqlite:///./ranked_bot.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ranked_bot

# ---------- drafter.lol (optional, needs a drafter.lol subscription key) ----------
DRAFTER_API_KEY=
DRAFTER_FEARLESS=false
# DRAFTER_API_BASE=https://api.drafter.lol
# DRAFTER_SERIES_PATH=/api/series

# ---------- OpenRouter chat (optional) ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
CHAT_BOT_NAME=Ranked Bot
# Channels where every message is for the bot (comma separated ids)
CHAT_CHANNEL_IDS=
# Keep replying to the same person for this long after the last exchange (no @ needed)
CHAT_FOLLOWUP_WINDOW_SECS=120
# Hard daily spend cap in tokens (prompt+completion). ~300k tokens/day on gpt-4o-mini is cents.
CHAT_DAILY_TOKEN_BUDGET=300000

# ---------- Ranking ----------
CURRENT_SEASON=1
STARTING_LP=1000
PLACEMENT_GAMES=5
MIN_GAME_MINUTES=15
INACTIVITY_DECAY_DAYS=14

# ---------- Lobby / automation ----------
LOBBY_SIZE=10
AUTO_DETECT_ENABLED=true
AUTO_DETECT_POLL_SECS=120
AUTO_DETECT_MIN_LOBBY_PLAYERS=8

# ---------- Anti-smurf ----------
SMURF_ENABLED=true
SMURF_SIMILARITY_THRESHOLD=0.72
SMURF_MIN_GAMES=3
SMURF_LOW_LEVEL=60
