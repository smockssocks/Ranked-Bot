# ---------- Discord ----------
DISCORD_TOKEN=your_discord_bot_token_here
# Your server's ID. Discord > Settings > Advanced > Developer Mode ON,
# then right-click your server name > Copy Server ID.
DISCORD_GUILD_ID=your_guild_id_here
# Optional: where smurf flags go (or set later with /admin modchannel)
MOD_CHANNEL_ID=
# Optional: extra channel for auto-detected results (or /admin resultschannel)
RESULTS_CHANNEL_ID=
# Optional: lock ALL inhouse queue commands to one channel (or /admin queuechannel)
QUEUE_CHANNEL_ID=

# ---------- Riot ----------
RIOT_API_KEY=your_riot_api_key_here
# RIOT_REGION is your server: na1 euw1 eun1 kr br1 la1 la2 oc1 tr1 ru jp1 ph2 sg2 th2 tw2 vn2 me1
# RIOT_PLATFORM must match it:
#   americas = na1 br1 la1 la2      europe = euw1 eun1 tr1 ru me1
#   asia     = kr jp1               sea    = oc1 ph2 sg2 th2 tw2 vn2
RIOT_REGION=na1
RIOT_PLATFORM=americas
# Tournament codes need a Production key with Tournament API access. See TOURNAMENT-CODES.md.
# Once Riot grants it: TOURNAMENT_CODES=true if it's your RIOT_API_KEY above,
# or paste a separate tournament key into RIOT_TOURNAMENT_API_KEY.
TOURNAMENT_CODES=false
RIOT_TOURNAMENT_API_KEY=
# Riot sends game results here. The bot doesn't need them, but Riot requires a valid
# http(s) address on the normal port. Your own website is best.
RIOT_TOURNAMENT_CALLBACK_URL=https://example.com/riot-callback

# ---------- Database ----------
# Postgres for production; sqlite works out of the box for trying things out.
DATABASE_URL=sqlite+aiosqlite:///./ranked_bot.db
# Database copies kept in the backups folder (one is made every start)
BACKUP_KEEP=14
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ranked_bot

# ---------- drafter.lol (optional, needs a drafter.lol subscription key) ----------
DRAFTER_API_KEY=
DRAFTER_FEARLESS=false
# DRAFTER_API_BASE=https://api.drafter.lol
# DRAFTER_SERIES_PATH=/api/series

# ---------- OpenRouter chat (optional) ----------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
CHAT_BOT_NAME=Ranked Bot
# Channels where every message is for the bot (comma separated ids)
CHAT_CHANNEL_IDS=
# Keep replying to the same person for this long after the last exchange (no @ needed)
CHAT_FOLLOWUP_WINDOW_SECS=120
# Hard daily spend cap in tokens (prompt+completion). ~300k tokens/day on gpt-4o-mini is cents.
CHAT_DAILY_TOKEN_BUDGET=300000

# ---------- Ranking ----------
CURRENT_SEASON=1
STARTING_LP=1000
PLACEMENT_GAMES=5
MIN_GAME_MINUTES=15
INACTIVITY_DECAY_DAYS=14

# ---------- Lobby / automation ----------
LOBBY_SIZE=10
# Starting values only; change them in Discord with /admin modes
# pick_order = no role queue (recommended), balanced = role queue, captain = captain draft
ALLOWED_MODES=pick_order,balanced,captain
DEFAULT_MODE=pick_order
CASUAL_ALLOWED=true
# Ready check: when a lobby fills, everyone must press Accept before it starts
READY_CHECK_ENABLED=true
READY_CHECK_SECONDS=90
# Declining, leaving, or not answering in time: out of the lobby and can't queue for this long
READY_CHECK_COOLDOWN_MINUTES=3
# Start the lobby by itself once everyone accepts (false = the host presses Start)
READY_CHECK_AUTO_START=true
# A private thread under the queue channel per started lobby, for its players and staff
GAME_CHANNELS_ENABLED=true
# Temporary Blue and Red voice channels per game, and moving players in voice into them
TEAM_VOICE_ENABLED=true
TEAM_VOICE_AUTO_MOVE=true
# Minutes after a game ends before its thread is closed and team voice removed (0 = never)
GAME_CHANNEL_CLEANUP_MINUTES=15
AUTO_DETECT_ENABLED=true
AUTO_DETECT_POLL_SECS=120
AUTO_DETECT_MIN_LOBBY_PLAYERS=8

# ---------- Anti-smurf ----------
SMURF_ENABLED=true
SMURF_SIMILARITY_THRESHOLD=0.72
SMURF_MIN_GAMES=3
SMURF_LOW_LEVEL=60
